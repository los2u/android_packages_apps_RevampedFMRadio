

cc_library_shared {
    name: "libqcomfmjni",

    srcs: [
        "FmIoctlsInterface.cpp",
        "ConfigFmThs.cpp",
        "FmPerformanceParams.cpp",
        "ConfFileParser.cpp",
        "FmRadioController.cpp",
        "LibfmJni.cpp",
    ],

    include_dirs: [
        "frameworks/base/core/jni/include",
    ],

    header_libs: ["jni_headers"],

    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
        "libmedia",
        "libnativehelper",
    ],

    // ANDROIDMK TRANSLATION ERROR: unsupported conditional
    // ifeq ($(TARGET_QCOM_NO_FM_FIRMWARE),true)

    cflags: ["-DQCOM_NO_FM_FIRMWARE"],
    // ANDROIDMK TRANSLATION ERROR: endif from unsupported conditional
    // endif

}
